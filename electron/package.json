{
  "name": "fisheye-ui-electron",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tree-kill": "^1.2.2"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.fisheyesonar.fisheye-ui",
    "productName": "FishEye",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updateCheck.js",
      "gpuSetup.js",
      "setup.html",
      "setup.js",
      "resources/gpu-runtime.manifest.json",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../packaging/pyinstaller/dist/fisheye-ui-backend",
        "to": "backend"
      }
    ],
    "mac": {
      "icon": "build-resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-setup.${ext}"
    }
  }
}
