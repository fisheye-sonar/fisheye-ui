[Unit]
Description=FishEye UI (GPU worker)
After=network.target

[Service]
Type=simple
User=ubuntu
# Explicit working directory - fisheye's job runner creates a "logs"
# directory relative to CWD, and systemd services default to CWD "/"
# (read-only) if this isn't set. Same class of bug hit and fixed in the
# Electron packaging, just at the systemd layer instead.
WorkingDirectory=/opt/fisheye-ui
Environment=FISHEYE_UI_NO_BROWSER=1
Environment=PORT=8000
# This box is a temporary stand-in we're personally paying for to support
# demos - the end goal is users running the GPU worker on their own cloud
# account instead. Surfaces a notice in the UI; remove once BYO-cloud ships.
Environment=FISHEYE_TEMPORARY_GPU_HOSTING=1
# 0.0.0.0, not the default 127.0.0.1 - the gateway box reverse-proxies to
# this worker over the private network, so it needs to be reachable on the
# instance's actual network interface, not just loopback.
Environment=HOST=0.0.0.0
# /tmp on this AMI is tmpfs - wiped whenever the idle-watcher stops the
# instance. Point uploads at the EBS-backed app dir instead so an input
# file mid-upload, or a finished job's results the user hasn't downloaded
# yet, survive a stop/start cycle. (Uploads still get cleaned up by the
# same age-based sweep/per-job cleanup as before, just off durable disk.)
Environment=FISHEYE_UI_UPLOAD_DIR=/opt/fisheye-ui/uploads
ExecStart=/home/ubuntu/.local/bin/poetry run fisheye-ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target